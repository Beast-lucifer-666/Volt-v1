<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="end">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient"
        android:scrollbars="none"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="140dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="50dp">

            <!-- Decorative Glow -->
            <View
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:background="@drawable/glow_outer"
                android:alpha="0.3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="-150dp"
                android:layout_marginTop="-50dp"/>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/greeting_morning"
                android:textColor="#7AABAA"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHomeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User's Home"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logout"
                android:contentDescription="@string/logout"
                app:layout_constraintEnd_toStartOf="@id/ivProfile"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="@id/ivProfile"
                app:layout_constraintBottom_toBottomOf="@id/ivProfile"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/circle_inner"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:contentDescription="@string/profile_picture"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Power Card -->
            <FrameLayout
                android:id="@+id/cardMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_glass_card"
                app:layout_constraintTop_toBottomOf="@id/tvHomeName">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvWholeHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/whole_home_live"
                        android:textColor="#7AABAA"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPowerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.2"
                        android:textColor="#00E5CC"
                        android:textSize="72sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvWholeHome" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/kw_label"
                        android:textColor="#4A7070"
                        app:layout_constraintBottom_toBottomOf="@id/tvPowerValue"
                        app:layout_constraintStart_toEndOf="@id/tvPowerValue" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:columnCount="2"
                        android:rowCount="3"
                        app:layout_constraintTop_toBottomOf="@id/tvPowerValue">

                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvVoltage" android:text="231 V" android:textColor="#00E5CC" style="@style/StatVal"/><TextView android:text="@string/voltage" style="@style/StatLab"/></LinearLayout>
                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvCurrent" android:text="13.8 A" android:textColor="#0066FF" style="@style/StatVal"/><TextView android:text="@string/current" style="@style/StatLab"/></LinearLayout>
                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvEnergyToday" android:text="18.4 kWh" android:textColor="#FF6B1A" style="@style/StatVal"/><TextView android:text="@string/energy_today" style="@style/StatLab"/></LinearLayout>
                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvPowerFactor" android:text="0.94" android:textColor="#CC1A00" style="@style/StatVal"/><TextView android:text="@string/power_factor" style="@style/StatLab"/></LinearLayout>
                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvTemperature" android:text="28.4°" android:textColor="#FF5252" style="@style/StatVal"/><TextView android:text="@string/temperature" style="@style/StatLab"/></LinearLayout>
                        <LinearLayout style="@style/StatBox"><TextView android:id="@+id/tvHumidity" android:text="62%" android:textColor="#0066FF" style="@style/StatVal"/><TextView android:text="@string/humidity" style="@style/StatLab"/></LinearLayout>
                    </GridLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Today's kWh Graph Card -->
            <FrameLayout
                android:id="@+id/cardGraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                app:layout_constraintTop_toBottomOf="@id/cardMain">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/graphContainerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTodayKwhTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todays_kwh"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvTodayKwhVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18.4 kWh"
                        android:textColor="#00E5CC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/graphContainer"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTodayKwhTitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/graphContainer">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="12 AM" android:textColor="#4A7070" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="12 PM" android:textColor="#4A7070" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="Now" android:textColor="#4A7070" android:textSize="10sp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Quick Controls Title -->
            <TextView
                android:id="@+id/tvQuickControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/quick_controls"
                android:textColor="#4A7070"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardGraph" />

            <TextView
                android:id="@+id/tvControlsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controls_summary"
                android:textColor="#00E5CC"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvQuickControls" />

            <!-- Quick Controls Row -->
            <LinearLayout
                android:id="@+id/rowQuickControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvQuickControls">

                <LinearLayout android:id="@+id/cardRelay1" style="@style/BottomStatCard">
                    <ImageView android:id="@+id/ivControl1" android:src="@drawable/ic_ac" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tvRelay1Name" android:text="AC Unit" style="@style/StatLab"/>
                    <TextView android:id="@+id/tvStatusRelay1" android:text="@string/status_on" style="@style/StatVal" android:textColor="#00E5CC" android:layout_marginTop="4dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchRelay1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:scaleX="0.7" android:scaleY="0.7" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardRelay2" style="@style/BottomStatCard">
                    <ImageView android:id="@+id/ivControl2" android:src="@drawable/ic_humidity" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tvRelay2Name" android:text="Fridge" style="@style/StatLab"/>
                    <TextView android:id="@+id/tvStatusRelay2" android:text="@string/status_on" style="@style/StatVal" android:textColor="#00E5CC" android:layout_marginTop="4dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchRelay2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:scaleX="0.7" android:scaleY="0.7" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Stats -->
            <LinearLayout
                android:id="@+id/rowBottomStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/rowQuickControls"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout style="@style/BottomStatCard">
                    <TextView android:id="@+id/tvSavings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹482" android:textColor="#00E5CC" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/saved_this_month" android:textColor="#4A7070" android:textSize="10sp"/>
                    <TextView android:id="@+id/tvSavingsPerc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ 12.4%" android:textColor="#00E5CC" android:textSize="12sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout style="@style/BottomStatCard">
                    <TextView android:id="@+id/tvCo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.1T" android:textColor="#9C27B0" android:textSize="24sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/co2_avoided" android:textColor="#4A7070" android:textSize="10sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ 8.1%" android:textColor="#00E5CC" android:textSize="12sp" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Side Panel Drawer -->
    <ScrollView
        android:id="@+id/sidePanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_side_panel"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Panel Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnClosePanel"
                    android:layout_centerVertical="true"
                    android:text="@string/profile_settings_title"
                    android:textColor="#00E5CC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnClosePanel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close_panel"
                    android:src="@drawable/ic_close" />
            </RelativeLayout>

            <!-- User Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPanelProfilePic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/circle_inner"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:contentDescription="@string/profile_picture" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPanelUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPanelEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="user@example.com"
                        android:textColor="#7AABAA"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#1E3533" />

            <!-- Edit Profile Picture Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/edit_profile_picture"
                android:textColor="#4A7070"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Preset Avatars -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/choose_avatar"
                android:textColor="#7AABAA"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPanelAvatar1"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:contentDescription="@string/avatar_1"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_avatar_1" />

                <ImageView
                    android:id="@+id/ivPanelAvatar2"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:contentDescription="@string/avatar_2"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_avatar_2" />

                <ImageView
                    android:id="@+id/ivPanelAvatar3"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:contentDescription="@string/avatar_3"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_avatar_3" />
            </LinearLayout>

            <!-- Upload Custom Photo -->
            <LinearLayout
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/upload_custom_photo"
                    android:textColor="#00E5CC"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#1E3533" />

            <!-- Edit Device Names according to Relay Nos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/edit_device_names"
                android:textColor="#4A7070"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Relay 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/relay_1"
                android:textColor="#7AABAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRelay1Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_relay_1"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A7070"
                android:textSize="14sp" />

            <!-- Relay 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/relay_2"
                android:textColor="#7AABAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRelay2Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_relay_2"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A7070"
                android:textSize="14sp" />

            <!-- Relay 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/relay_3"
                android:textColor="#7AABAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRelay3Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_relay_3"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A7070"
                android:textSize="14sp" />

            <!-- Relay 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/relay_4"
                android:textColor="#7AABAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etRelay4Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_relay_4"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A7070"
                android:textSize="14sp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_signin"
                android:text="@string/save_changes"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
